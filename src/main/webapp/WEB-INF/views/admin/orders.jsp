<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Orders | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/users">Users</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><span class="muted">Orders</span><a href="${pageContext.request.contextPath}/admin/statistics">Statistics</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="admin-heading"><p class="eyebrow">Platform orders</p><h1>Orders</h1></section><form class="admin-filter-form" method="get"><input name="search" placeholder="Search order ID, buyer name, or email" value="<c:out value='${param.search}'/>"><select name="status"><option value="">All statuses</option><option value="PENDING">Pending</option><option value="CONFIRMED">Confirmed</option><option value="PROCESSING">Processing</option><option value="SHIPPED">Shipped</option><option value="DELIVERED">Delivered</option><option value="CANCELLED">Cancelled</option></select><button type="submit">Filter</button></form><section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Buyer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#${order.id}</td><td><c:out value="${order.buyerName}"/><br><span class="muted"><c:out value="${order.buyerEmail}"/></span></td><td>${order.createdAt}</td><td>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" maxFractionDigits="2"/></td><td><span class="status-pill">${order.status}</span></td><td><a href="${pageContext.request.contextPath}/admin/orders/view?id=${order.id}">View details</a></td></tr></c:forEach></tbody></table><c:if test="${empty orders}"><p class="empty-inline">No matching orders.</p></c:if></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
