<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Order confirmed | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><a href="${pageContext.request.contextPath}/orders">My orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="confirmation-card"><p class="eyebrow">Thank you for your purchase</p><h1>Order confirmed!</h1><p class="confirmation-number">Order #FM${order.id}</p><p>Your order has been saved successfully.</p><p class="confirmation-total">Total: ₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" maxFractionDigits="2"/></p><div class="confirmation-actions"><a class="primary-link" href="${pageContext.request.contextPath}/order?id=${order.id}">View order</a><a class="text-link" href="${pageContext.request.contextPath}/products">Continue shopping →</a></div></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
