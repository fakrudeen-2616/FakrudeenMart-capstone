<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Product details | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><c:if test="${sessionScope.userRole == 'BUYER'}"><a href="${pageContext.request.contextPath}/cart">Cart</a></c:if></nav></header><c:choose><c:when test="${not empty product}"><section class="detail-layout"><div class="detail-image-wrap"><img class="detail-image" src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>" onerror="this.onerror=null;this.src='${pageContext.request.contextPath}/images/product-placeholder.svg';"></div><div class="detail-copy"><p class="eyebrow"><c:out value="${product.categoryName}"/></p><h1><c:out value="<c:out value='${product.name}'/>"/></h1><p class="detail-price">₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></p><p class="detail-rating"><c:choose><c:when test="${not empty reviewSummary.averageRating}">★ <fmt:formatNumber value="${reviewSummary.averageRating}" minFractionDigits="1" maxFractionDigits="1"/> / 5 · ${reviewSummary.reviewCount} review<c:if test="${reviewSummary.reviewCount != 1}">s</c:if></c:when><c:otherwise>No reviews yet</c:otherwise></c:choose></p><p class="detail-description"><c:out value="${product.description}"/></p><dl class="detail-meta"><dt>Sold by</dt><dd><c:out value="${product.sellerName}"/></dd><dt>Availability</dt><dd><c:choose><c:when test="${product.inStock}"><span class="in-stock">In stock · ${product.stockQuantity} available</span></c:when><c:otherwise><span class="out-stock">Out of stock</span></c:otherwise></c:choose></dd><dt>Product status</dt><dd><c:out value="${product.status}"/></dd></dl><c:if test="${sessionScope.userRole == 'BUYER' && product.inStock}"><form class="detail-add-form" method="post" action="${pageContext.request.contextPath}/cart/add"><input type="hidden" name="productId" value="${product.id}"><label for="detail-quantity">Quantity</label><input id="detail-quantity" name="quantity" type="number" min="1" max="99" value="1"><button type="submit">Add to cart</button></form></c:if></div></section><section class="reviews-section"><div class="reviews-heading"><div><p class="eyebrow">Customer feedback</p><h2>Reviews</h2></div><form method="get" action="${pageContext.request.contextPath}/product"><input type="hidden" name="id" value="${product.id}"><label for="reviewSort">Sort</label><select id="reviewSort" name="reviewSort"><option value="NEWEST" ${param.reviewSort == 'OLDEST' || param.reviewSort == 'HIGHEST' || param.reviewSort == 'LOWEST' ? '' : 'selected'}>Newest</option><option value="OLDEST" ${param.reviewSort == 'OLDEST' ? 'selected' : ''}>Oldest</option><option value="HIGHEST" ${param.reviewSort == 'HIGHEST' ? 'selected' : ''}>Highest rated</option><option value="LOWEST" ${param.reviewSort == 'LOWEST' ? 'selected' : ''}>Lowest rated</option></select><button class="small-button" type="submit">Sort</button></form></div><c:if test="${not empty reviewMessage}"><p class="notice success"><c:out value="${reviewMessage}"/></p></c:if><c:if test="${not empty reviewError}"><p class="notice error"><c:out value="${reviewError}"/></p></c:if><c:choose><c:when test="${empty reviews}"><div class="empty-state review-empty"><h3>No reviews yet.</h3><p>Be the first customer to share your experience.</p></div></c:when><c:otherwise><div class="review-list"><c:forEach var="review" items="${reviews}"><article class="review-card"><div class="review-card-top"><strong><c:out value="${review.reviewerName}"/></strong><span class="review-stars" aria-label="${review.rating} out of 5">★ ${review.rating}/5</span><time datetime="${review.createdAt}">${review.createdAt}</time></div><p><c:out value="${review.comment}"/></p><c:if test="${sessionScope.userId == review.userId}"><div class="review-actions"><a href="${pageContext.request.contextPath}/reviews/edit?id=${review.id}">Edit</a><form method="post" action="${pageContext.request.contextPath}/reviews/delete" onsubmit="return confirm('Delete this review?');"><input type="hidden" name="reviewId" value="${review.id}"><button class="button-link" type="submit">Delete</button></form></div></c:if></article></c:forEach></div></c:otherwise></c:choose><section class="review-form-card"><h3>Write a review</h3><c:choose><c:when test="${sessionScope.userRole != 'BUYER'}"><p class="muted">Please login as a buyer to review this product.</p></c:when><c:when test="${reviewSummary.reviewed}"><p class="muted">You have already reviewed this product.</p><a class="text-link" href="${pageContext.request.contextPath}/reviews/edit?id=${reviewSummary.userReview.id}">Edit your review</a></c:when><c:when test="${reviewSummary.purchased}"><form method="post" action="${pageContext.request.contextPath}/reviews/create"><input type="hidden" name="productId" value="${product.id}"><label for="rating">Your rating</label><select id="rating" name="rating" required><option value="">Select rating</option><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Average</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select><label for="comment">Your review</label><textarea id="comment" name="comment" rows="5" maxlength="2000" required placeholder="Share your experience"></textarea><button type="submit">Submit review</button></form></c:when><c:otherwise><p class="muted">Purchase this product to leave a review.</p></c:otherwise></c:choose></section></section></c:when><c:otherwise><section class="empty-state detail-empty"><h1><c:out value="${unavailableMessage}"/></h1><a class="card-link" href="${pageContext.request.contextPath}/products">Return to products →</a></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
