<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Products | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><c:choose><c:when test="${not empty sessionScope.userId}"><a href="${pageContext.request.contextPath}/products">Products</a><c:if test="${sessionScope.userRole == 'BUYER'}"><a href="${pageContext.request.contextPath}/cart">Cart</a></c:if><span class="muted"><c:out value="${sessionScope.userName}"/></span><a href="${pageContext.request.contextPath}/logout">Logout</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/buyer/login">Login</a><a href="${pageContext.request.contextPath}/buyer/register">Register</a></c:otherwise></c:choose></nav></header><section class="catalog-heading"><p class="eyebrow">The marketplace</p><h1>Find something useful.</h1><p class="catalog-intro">Browse thoughtfully selected products from independent sellers.</p></section><form class="catalog-filters" method="get" action="${pageContext.request.contextPath}/products"><div class="filter-wide"><label for="search">Search</label><input id="search" name="search" type="search" value="${search}" placeholder="Search products..."></div><div><label for="category">Category</label><select id="category" name="category"><option value="">All categories</option><c:forEach var="category" items="${categories}"><option value="${category.id}" ${selectedCategory == category.id.toString() ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select></div><div><label for="sort">Sort by</label><select id="sort" name="sort"><option value="newest" ${selectedSort == 'newest' ? 'selected' : ''}>Newest</option><option value="price_asc" ${selectedSort == 'price_asc' ? 'selected' : ''}>Price: low to high</option><option value="price_desc" ${selectedSort == 'price_desc' ? 'selected' : ''}>Price: high to low</option><option value="name_asc" ${selectedSort == 'name_asc' ? 'selected' : ''}>Name: A to Z</option><option value="name_desc" ${selectedSort == 'name_desc' ? 'selected' : ''}>Name: Z to A</option></select></div><div><label for="stock">Availability</label><select id="stock" name="stock"><option value="all" ${selectedStock == 'all' ? 'selected' : ''}>All</option><option value="in" ${selectedStock == 'in' ? 'selected' : ''}>In stock</option><option value="out" ${selectedStock == 'out' ? 'selected' : ''}>Out of stock</option></select></div><div><label for="minPrice">Min price</label><input id="minPrice" name="minPrice" type="number" min="0" step="0.01" value="${minPrice}"></div><div><label for="maxPrice">Max price</label><input id="maxPrice" name="maxPrice" type="number" min="0" step="0.01" value="${maxPrice}"></div><button type="submit">Apply filters</button></form><c:if test="${not empty error}"><p class="notice error"><c:out value="${error}"/> Showing the latest products instead.</p></c:if><c:if test="${not empty pageResult and pageResult.totalItems > 0}"><p class="result-count">Showing ${pageResult.firstItemNumber}–${pageResult.lastItemNumber} of ${pageResult.totalItems} products</p></c:if><c:choose><c:when test="${empty products}"><section class="empty-state"><h2>No products found.</h2><p>Try changing your search or filters.</p></section></c:when><c:otherwise><section class="product-grid"><c:forEach var="product" items="${products}"><article class="product-card"><a class="product-image-link" href="${pageContext.request.contextPath}/product?id=${product.id}"><img class="product-image" src="<c:out value='${product.imageUrl}'/>" alt="<c:out value='${product.name}'/>" onerror="this.onerror=null;this.src='${pageContext.request.contextPath}/images/product-placeholder.svg';"></a><div class="product-card-body"><p class="product-category"><c:out value="${product.categoryName}"/></p><h2><c:out value="${product.name}"/></h2><p class="product-price">₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></p><c:if test="${not empty product.averageRating}"><p class="detail-rating">★ <fmt:formatNumber value="${product.averageRating}" minFractionDigits="1" maxFractionDigits="1"/> · ${product.reviewCount} review<c:if test="${product.reviewCount != 1}">s</c:if></p></c:if><p class="stock-label ${product.inStock ? 'in-stock' : 'out-stock'}"><c:choose><c:when test="${product.inStock}">In stock · ${product.stockQuantity}</c:when><c:otherwise>Out of stock</c:otherwise></c:choose></p><a class="card-link" href="${pageContext.request.contextPath}/product?id=${product.id}">View details →</a><c:if test="${sessionScope.userRole == 'BUYER' && product.inStock}"><form class="quick-add-form" method="post" action="${pageContext.request.contextPath}/cart/add"><input type="hidden" name="productId" value="${product.id}"><input type="hidden" name="quantity" value="1"><button type="submit">Add to cart</button></form></c:if></div></article></c:forEach></section><c:if test="${pageResult.totalPages > 1}"><nav class="pagination" aria-label="Product pages"><c:if test="${pageResult.previousAvailable}"><c:url var="previousUrl" value="/products"><c:param name="page" value="${pageResult.page - 1}"/><c:param name="search" value="${search}"/><c:param name="category" value="${selectedCategory}"/><c:param name="minPrice" value="${minPrice}"/><c:param name="maxPrice" value="${maxPrice}"/><c:param name="stock" value="${selectedStock}"/><c:param name="sort" value="${selectedSort}"/></c:url><a href="${previousUrl}">Previous</a></c:if><span>Page ${pageResult.page} of ${pageResult.totalPages}</span><c:if test="${pageResult.nextAvailable}"><c:url var="nextUrl" value="/products"><c:param name="page" value="${pageResult.page + 1}"/><c:param name="search" value="${search}"/><c:param name="category" value="${selectedCategory}"/><c:param name="minPrice" value="${minPrice}"/><c:param name="maxPrice" value="${maxPrice}"/><c:param name="stock" value="${selectedStock}"/><c:param name="sort" value="${selectedSort}"/></c:url><a href="${nextUrl}">Next</a></c:if></nav></c:if></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
