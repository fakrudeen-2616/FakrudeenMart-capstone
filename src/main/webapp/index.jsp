<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>FakrudeenMart | Thoughtful shopping</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="site-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav aria-label="Primary navigation"><a href="${pageContext.request.contextPath}/products">Shop</a><c:choose><c:when test="${not empty sessionScope.userId}"><c:if test="${sessionScope.userRole == 'BUYER'}"><a href="${pageContext.request.contextPath}/buyer/home">Buyer Home</a><a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/orders">Orders</a></c:if><c:if test="${sessionScope.userRole == 'SELLER'}"><a href="${pageContext.request.contextPath}/seller/dashboard">Seller Center</a></c:if><c:if test="${sessionScope.userRole == 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin/dashboard">Admin Center</a></c:if><span class="muted"><c:out value="${sessionScope.userName}"/></span><a href="${pageContext.request.contextPath}/logout">Logout</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/buyer/login">Buyer Login</a><a href="${pageContext.request.contextPath}/seller/login">Seller Login</a><a href="${pageContext.request.contextPath}/admin/login">Admin Login</a></c:otherwise></c:choose></nav></header><section class="hero hero-home"><div class="hero-copy"><p class="eyebrow">A considered marketplace</p><h1>Discover useful products from independent sellers.</h1><p>Browse a focused catalog, shop with confidence, and keep every order and review in one clear place.</p><div class="hero-actions"><a class="primary-link" href="${pageContext.request.contextPath}/products">Shop the catalog</a><a class="secondary-link" href="${pageContext.request.contextPath}/buyer/register">Create Buyer Account</a></div></div><div class="hero-panel" aria-label="Marketplace highlights"><span class="hero-panel-kicker">Built for clarity</span><strong>Find. Compare. Order.</strong><p>Buyers shop in a dedicated storefront while sellers manage products, inventory, orders, and sales in Seller Center.</p><div class="hero-panel-actions"><a href="${pageContext.request.contextPath}/seller/register">Create Seller Account</a><a href="${pageContext.request.contextPath}/seller/login">Seller Login</a></div></div></section><section class="home-value-grid" aria-label="Marketplace benefits"><article><span class="value-number">01</span><h2>Buyer storefront</h2><p>Search and filter the live catalog by category, price, stock, and sorting options.</p><a href="${pageContext.request.contextPath}/buyer/login">Enter Buyer App →</a></article><article><span class="value-number">02</span><h2>Seller Center</h2><p>Manage your owned products, inventory, relevant orders, status updates, and sales.</p><a href="${pageContext.request.contextPath}/seller/login">Enter Seller Center →</a></article><article><span class="value-number">03</span><h2>Verified experience</h2><p>Buyers can leave ratings and reviews after purchasing products.</p><a href="${pageContext.request.contextPath}/products">See the catalog →</a></article></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
