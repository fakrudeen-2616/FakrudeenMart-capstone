<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Checkout | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/orders">My orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="checkout-heading"><p class="eyebrow">Final review</p><h1>Checkout</h1><p class="catalog-intro">Review your items before placing this order. Prices and totals are calculated from the current catalog.</p></section><c:if test="${not empty param.error}"><p class="notice error"><c:out value="${param.error}"/></p></c:if><c:if test="${not empty error}"><p class="notice error"><c:out value="${error}"/></p></c:if><c:choose><c:when test="${empty checkout or checkout.empty}"><section class="empty-state"><h2>Your cart is empty.</h2><p>Add products to your cart before checkout.</p><a class="text-link" href="${pageContext.request.contextPath}/products">Continue shopping →</a></section></c:when><c:otherwise><section class="checkout-layout"><div class="checkout-items"><h2>Order items</h2><c:forEach var="item" items="${checkout.items}"><article class="checkout-item"><div><h3><c:out value="${item.productName}"/></h3><p class="muted">₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/> × ${item.quantity}</p></div><strong>₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></c:forEach></div><aside class="checkout-summary"><p class="eyebrow">Order summary</p><h2>₹<fmt:formatNumber value="${checkout.total}" minFractionDigits="2" maxFractionDigits="2"/></h2><p class="muted small">This college MVP simulates successful checkout. No payment credentials are collected.</p><form method="post" action="${pageContext.request.contextPath}/place-order"><button class="place-order-button" type="submit">Place order</button></form><a class="text-link" href="${pageContext.request.contextPath}/cart">Back to cart</a></aside></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
