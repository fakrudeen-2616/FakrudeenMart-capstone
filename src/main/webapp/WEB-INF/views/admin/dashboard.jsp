<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Dashboard | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/buyers">Buyers</a><a href="${pageContext.request.contextPath}/admin/sellers">Sellers</a><a href="${pageContext.request.contextPath}/admin/users">Users</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><a href="${pageContext.request.contextPath}/admin/statistics">Statistics</a><a href="${pageContext.request.contextPath}/admin/profile">Profile</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="admin-heading"><p class="eyebrow">Platform control</p><h1>Welcome, <c:out value="${admin.fullName}"/></h1><p class="catalog-intro">Monitor the marketplace and manage accounts, products, and orders.</p></section><section class="admin-stat-grid"><article class="admin-stat-card"><span>Users</span><strong>${stats.totalUsers}</strong><small>${stats.buyers} buyers · ${stats.sellers} sellers · ${stats.activeUsers} active</small></article><article class="admin-stat-card"><span>Products</span><strong>${stats.totalProducts}</strong><small>${stats.activeProducts} active · ${stats.outOfStockProducts} out of stock</small></article><article class="admin-stat-card"><span>Orders</span><strong>${stats.totalOrders}</strong><small>${stats.pendingOrders} pending · ${stats.processingOrders} processing</small></article><article class="admin-stat-card admin-stat-accent"><span>Platform sales</span><strong>₹<fmt:formatNumber value="${stats.totalSales}" minFractionDigits="2" maxFractionDigits="2"/></strong><small>Cancelled orders excluded</small></article></section><section class="admin-actions"><h2>Quick actions</h2><a class="primary-link" href="${pageContext.request.contextPath}/admin/buyers">Manage buyers</a><a class="secondary-link" href="${pageContext.request.contextPath}/admin/sellers">Manage sellers</a><a class="secondary-link" href="${pageContext.request.contextPath}/admin/products">Manage products</a><a class="secondary-link" href="${pageContext.request.contextPath}/admin/orders">Manage orders</a></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
