<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:choose><c:when test="${registrationRole == 'SELLER'}">Create Seller Account</c:when><c:otherwise>Create Buyer Account</c:otherwise></c:choose> | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body class="auth-page role-auth-${registrationRole}"><main class="auth-shell"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><section class="auth-card"><p class="eyebrow"><c:choose><c:when test="${registrationRole == 'SELLER'}">Seller Center</c:when><c:otherwise>Buyer marketplace</c:otherwise></c:choose></p><h1><c:choose><c:when test="${registrationRole == 'SELLER'}">Create Seller Account</c:when><c:otherwise>Create Buyer Account</c:otherwise></c:choose></h1><c:if test="${not empty error}"><p class="notice error"><c:out value="${error}"/></p></c:if><form method="post" action="${registrationAction}"><label for="fullName"><c:choose><c:when test="${registrationRole == 'SELLER'}">Seller name</c:when><c:otherwise>Full name</c:otherwise></c:choose></label><input id="fullName" name="fullName" type="text" value="<c:out value='${fullName}'/>" required autocomplete="name"><label for="email">Email</label><input id="email" name="email" type="email" value="<c:out value='${email}'/>" required autocomplete="email"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" value="<c:out value='${phone}'/>" autocomplete="tel"><label for="password">Password</label><input id="password" name="password" type="password" required minlength="6" autocomplete="new-password"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" required minlength="6" autocomplete="new-password"><button type="submit">Create account</button></form><p class="auth-footer"><c:choose><c:when test="${registrationRole == 'SELLER'}">Already a seller? <a href="${pageContext.request.contextPath}/seller/login">Seller Login</a></c:when><c:otherwise>Already a buyer? <a href="${pageContext.request.contextPath}/buyer/login">Buyer Login</a></c:otherwise></c:choose></p></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
