<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My Orders | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><a href="${pageContext.request.contextPath}/cart">Cart</a><span class="muted">My orders</span><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="orders-heading"><p class="eyebrow">Your purchase history</p><h1>My orders</h1></section><c:choose><c:when test="${empty orders}"><section class="empty-state"><h2>You haven't placed any orders yet.</h2><p>Start shopping to see your orders here.</p><a class="text-link" href="${pageContext.request.contextPath}/products">Browse products →</a></section></c:when><c:otherwise><section class="order-list"><c:forEach var="order" items="${orders}"><article class="order-card"><div><p class="eyebrow">Order #FM${order.id}</p><h2>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" maxFractionDigits="2"/></h2><p class="muted">${order.createdAt}</p></div><div class="order-status"><span class="status-pill">${order.status}</span><a class="text-link" href="${pageContext.request.contextPath}/order?id=${order.id}">View details →</a></div></article></c:forEach></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
