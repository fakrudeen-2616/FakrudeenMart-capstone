<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shopping Cart | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><span class="muted">Cart (${cart.totalItems})</span><a href="${pageContext.request.contextPath}/orders">My orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="cart-heading"><p class="eyebrow">Your saved selections</p><h1>Shopping cart</h1><c:if test="${not empty message}"><p class="notice"><c:out value="${message}"/></p></c:if></section><c:choose><c:when test="${empty cart.items}"><section class="empty-state"><h2>Your cart is empty.</h2><p>Browse products and add something you like.</p><a class="text-link" href="${pageContext.request.contextPath}/products">Continue shopping →</a></section></c:when><c:otherwise><section class="cart-layout"><div class="cart-items"><c:forEach var="item" items="${cart.items}"><article class="cart-item ${item.available ? '' : 'cart-item-unavailable'}"><img class="cart-item-image" src="${item.imageUrl}" alt="${item.productName}" onerror="this.onerror=null;this.src='${pageContext.request.contextPath}/images/product-placeholder.svg';"><div class="cart-item-main"><h2><c:out value="${item.productName}"/></h2><p class="muted">₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/> each · ${item.stockQuantity} currently available</p><p class="stock-label ${item.available ? 'in-stock' : 'out-stock'}"><c:out value="${item.availabilityMessage}"/></p></div><form class="quantity-form" method="post" action="${pageContext.request.contextPath}/cart/update"><input type="hidden" name="itemId" value="${item.itemId}"><label for="quantity-${item.itemId}">Quantity</label><input id="quantity-${item.itemId}" name="quantity" type="number" min="1" max="99" value="${item.quantity}"><button type="submit">Update</button></form><div class="cart-item-subtotal"><span>Subtotal</span><strong>₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong><form method="post" action="${pageContext.request.contextPath}/cart/remove"><input type="hidden" name="itemId" value="${item.itemId}"><button class="button-link" type="submit">Remove</button></form></div></article></c:forEach></div><aside class="cart-summary"><h2>Summary</h2><dl><dt>Total items</dt><dd>${cart.totalItems}</dd><dt>Subtotal</dt><dd>₹<fmt:formatNumber value="${cart.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></dd><dt class="summary-total">Grand total</dt><dd class="summary-total">₹<fmt:formatNumber value="${cart.total}" minFractionDigits="2" maxFractionDigits="2"/></dd></dl><p class="muted small">Taxes, shipping, discounts, and payment are not part of this module.</p><a class="checkout-link" href="${pageContext.request.contextPath}/checkout">Review and checkout</a><form method="post" action="${pageContext.request.contextPath}/cart/clear"><button class="secondary-button" type="submit">Clear cart</button></form><a class="text-link" href="${pageContext.request.contextPath}/products">Continue shopping →</a></aside></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
