<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Order details | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="catalog-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/products">Products</a><a href="${pageContext.request.contextPath}/orders">My orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="order-detail-heading"><p class="eyebrow">Order #FM${order.id}</p><h1>Order details</h1><p class="muted">Placed ${order.createdAt}</p><span class="status-pill">${order.status}</span></section><section class="order-detail-layout"><div class="order-detail-items"><h2>Products</h2><c:forEach var="item" items="${order.items}"><article class="order-detail-item"><div><h3><c:out value="${item.productName}"/></h3><p class="muted">₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/> × ${item.quantity}</p></div><strong>₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></c:forEach></div><aside class="checkout-summary"><p class="eyebrow">Order total</p><h2>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" maxFractionDigits="2"/></h2><a class="text-link" href="${pageContext.request.contextPath}/orders">Back to orders</a></aside></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
