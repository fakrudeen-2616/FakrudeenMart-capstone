<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seller Order | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="seller-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/seller/dashboard">FAKRUDEENMART SELLER CENTER</a><nav><a href="${pageContext.request.contextPath}/seller/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/seller/products">My Products</a><a href="${pageContext.request.contextPath}/seller/orders">Orders</a><a href="${pageContext.request.contextPath}/seller/profile">Profile</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="seller-heading"><p class="eyebrow">Order #${order.orderId}</p><h1>Relevant order details</h1><p>Buyer: <c:out value="${order.buyerName}"/></p><p class="muted">${order.createdAt} · <span class="status-pill">${order.status}</span></p></section><section class="seller-order-detail"><h2>Your items</h2><c:forEach var="item" items="${order.items}"><article class="seller-order-line"><div><h3><c:out value="${item.productName}"/></h3><p class="muted">₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/> × ${item.quantity}</p></div><strong>₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></c:forEach><div class="seller-order-total"><span>Your subtotal</span><strong>₹<fmt:formatNumber value="${order.sellerSubtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></div><div class="status-actions"><c:if test="${order.status == 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/seller/order/status"><input type="hidden" name="id" value="${order.orderId}"><input type="hidden" name="status" value="CONFIRMED"><button type="submit">Confirm order</button></form></c:if><c:if test="${order.status == 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/seller/order/status"><input type="hidden" name="id" value="${order.orderId}"><input type="hidden" name="status" value="PROCESSING"><button type="submit">Mark processing</button></form></c:if><c:if test="${order.status == 'PROCESSING'}"><form method="post" action="${pageContext.request.contextPath}/seller/order/status"><input type="hidden" name="id" value="${order.orderId}"><input type="hidden" name="status" value="SHIPPED"><button type="submit">Mark shipped</button></form></c:if><c:if test="${order.status == 'SHIPPED'}"><form method="post" action="${pageContext.request.contextPath}/seller/order/status"><input type="hidden" name="id" value="${order.orderId}"><input type="hidden" name="status" value="DELIVERED"><button type="submit">Mark delivered</button></form></c:if></div></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
