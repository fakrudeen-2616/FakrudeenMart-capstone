<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage Products | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="seller-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/seller/dashboard">FAKRUDEENMART</a><nav><a href="${pageContext.request.contextPath}/seller/dashboard">Dashboard</a><span class="muted">Products</span><a href="${pageContext.request.contextPath}/seller/orders">Orders</a><a href="${pageContext.request.contextPath}/seller/profile">Profile</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="seller-heading seller-heading-row"><div><p class="eyebrow">Your catalog</p><h1>Manage products</h1></div><a class="primary-link compact-link" href="${pageContext.request.contextPath}/seller/products/add">Add product</a></section><c:choose><c:when test="${empty products}"><section class="empty-state"><h2>No products yet.</h2><p>Add your first product to start selling.</p><a class="text-link" href="${pageContext.request.contextPath}/seller/products/add">Add product →</a></section></c:when><c:otherwise><section class="seller-product-list"><c:forEach var="product" items="${products}"><article class="seller-product-card"><div><p class="product-category"><c:out value="${product.categoryName}"/></p><h2><c:out value="${product.name}"/></h2><p class="muted">Created ${product.createdAt}</p></div><div class="seller-product-meta"><span>₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></span><span class="${product.stockQuantity == 0 ? 'out-stock' : 'in-stock'}">Stock ${product.stockQuantity}</span><span class="status-pill ${product.status == 'ACTIVE' ? 'status-active' : 'status-inactive'}">${product.status}</span></div><div class="seller-product-actions"><a class="secondary-link" href="${pageContext.request.contextPath}/seller/products/edit?id=${product.id}">Edit</a><form method="post" action="${pageContext.request.contextPath}/seller/products/stock"><input type="hidden" name="id" value="${product.id}"><label for="stock-${product.id}">Stock</label><input id="stock-${product.id}" name="stockQuantity" type="number" min="0" value="${product.stockQuantity}"><button type="submit">Save stock</button></form><form method="post" action="${pageContext.request.contextPath}/seller/products/status"><input type="hidden" name="id" value="${product.id}"><input type="hidden" name="action" value="${product.status == 'ACTIVE' ? 'deactivate' : 'activate'}"><button class="secondary-button" type="submit">${product.status == 'ACTIVE' ? 'Deactivate' : 'Activate'}</button></form><form method="post" action="${pageContext.request.contextPath}/seller/products/delete"><input type="hidden" name="id" value="${product.id}"><button class="button-link" type="submit">Remove</button></form></div></article></c:forEach></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
