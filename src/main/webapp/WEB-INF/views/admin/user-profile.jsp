<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${profileType} Profile | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/buyers">Buyers</a><a href="${pageContext.request.contextPath}/admin/sellers">Sellers</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="admin-heading"><p class="eyebrow">${profileType} profile</p><h1><c:out value="${user.fullName}"/></h1><div class="profile-card"><dl><dt>User ID</dt><dd>${user.id}</dd><dt>Email</dt><dd><c:out value="${user.email}"/></dd><dt>Phone</dt><dd><c:out value="${user.phone}"/></dd><dt>Role</dt><dd>${user.role}</dd><dt>Status</dt><dd><span class="status-pill">${user.status}</span></dd><dt>Registered</dt><dd>${user.createdAt}</dd></dl><a class="secondary-link" href="${pageContext.request.contextPath}/admin/${profileType == 'buyer' ? 'buyers' : 'sellers'}/edit?id=${user.id}">Edit profile</a></div></section><c:if test="${profileType == 'buyer'}"><h2>Buyer statistics</h2><section class="admin-stat-grid"><article class="admin-stat-card"><span>Total orders</span><strong>${buyerStats.totalOrders}</strong></article><article class="admin-stat-card"><span>Total spent</span><strong>₹<fmt:formatNumber value="${buyerStats.totalSpent}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></section><h2>Buyer orders</h2><section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#${order.id}</td><td>${order.createdAt}</td><td>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${order.status}</td><td><a href="${pageContext.request.contextPath}/admin/orders/view?id=${order.id}">View</a></td></tr></c:forEach></tbody></table></section></c:if><c:if test="${profileType == 'seller'}"><h2>Seller statistics</h2><section class="admin-stat-grid"><article class="admin-stat-card"><span>Products</span><strong>${sellerStats.totalProducts}</strong><small>${sellerStats.activeProducts} active · ${sellerStats.outOfStockProducts} out of stock</small></article><article class="admin-stat-card"><span>Orders</span><strong>${sellerStats.totalOrders}</strong><small>${sellerStats.processingOrders} processing · ${sellerStats.shippedOrders} shipped</small></article><article class="admin-stat-card admin-stat-accent"><span>Sales</span><strong>₹<fmt:formatNumber value="${sellerStats.totalSales}" minFractionDigits="2" maxFractionDigits="2"/></strong></article></section><h2>Seller products</h2><section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th></tr></thead><tbody><c:forEach var="product" items="${products}"><tr><td><c:out value="${product.name}"/></td><td><c:out value="${product.categoryName}"/></td><td>₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${product.stockQuantity}</td><td>${product.status}</td></tr></c:forEach></tbody></table></section><h2>Seller orders</h2><section class="seller-order-list"><c:forEach var="order" items="${sellerOrders}"><article class="seller-order-card"><p class="eyebrow">Order #${order.orderId}</p><p>${order.createdAt} · ${order.status}</p><c:forEach var="item" items="${order.items}"><p><c:out value="${item.productName}"/> × ${item.quantity} — ₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></p></c:forEach></article></c:forEach></section></c:if></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
