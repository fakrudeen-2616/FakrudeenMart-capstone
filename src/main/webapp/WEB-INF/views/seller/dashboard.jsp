<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seller Dashboard | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="seller-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/seller/dashboard">FAKRUDEENMART</a><nav><span class="muted">Seller dashboard</span><a href="${pageContext.request.contextPath}/seller/products">Products</a><a href="${pageContext.request.contextPath}/seller/orders">Orders</a><a href="${pageContext.request.contextPath}/seller/profile">Profile</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="seller-heading"><p class="eyebrow">Seller workspace</p><h1>Welcome, <c:out value="${seller.fullName}"/></h1><p class="catalog-intro">Manage your catalog and follow orders containing your products.</p></section><section class="stat-grid"><article class="stat-card"><span>Products</span><strong>${stats.totalProducts}</strong><small>${stats.activeProducts} active · ${stats.lowStockProducts} low stock · ${stats.outOfStockProducts} out of stock</small></article><article class="stat-card"><span>Orders</span><strong>${stats.totalOrders}</strong><small>${stats.pendingOrders} pending · ${stats.processingOrders} processing</small></article><article class="stat-card"><span>Shipping</span><strong>${stats.shippedOrders + stats.deliveredOrders}</strong><small>${stats.shippedOrders} shipped · ${stats.deliveredOrders} delivered</small></article><article class="stat-card stat-card-accent"><span>Your sales</span><strong>₹<fmt:formatNumber value="${stats.totalSales}" minFractionDigits="2" maxFractionDigits="2"/></strong><small>Based on your order items only</small></article></section><section class="quick-actions"><h2>Quick actions</h2><a class="primary-link" href="${pageContext.request.contextPath}/seller/products/add">Add product</a><a class="secondary-link" href="${pageContext.request.contextPath}/seller/products">Manage products</a><a class="secondary-link" href="${pageContext.request.contextPath}/seller/orders">View orders</a></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
