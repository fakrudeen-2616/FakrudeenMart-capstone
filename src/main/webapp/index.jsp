<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>FakrudeenMart | Thoughtful shopping</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="site-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/">FAKRUDEENMART</a><nav aria-label="Primary navigation"><a href="${pageContext.request.contextPath}/products">Products</a><c:choose><c:when test="${not empty sessionScope.userId}"><c:if test="${sessionScope.userRole == 'BUYER'}"><a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/orders">Orders</a></c:if><c:if test="${sessionScope.userRole == 'SELLER'}"><a href="${pageContext.request.contextPath}/seller/dashboard">Seller dashboard</a></c:if><c:if test="${sessionScope.userRole == 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin/dashboard">Admin dashboard</a></c:if><span class="muted"><c:out value="${sessionScope.userName}"/></span><a href="${pageContext.request.contextPath}/logout">Logout</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">Login</a><a class="nav-cta" href="${pageContext.request.contextPath}/register">Create account</a></c:otherwise></c:choose></nav></header><section class="hero hero-home"><div class="hero-copy"><p class="eyebrow">A considered marketplace</p><h1>Discover useful products from independent sellers.</h1><p>Browse a focused catalog, shop with confidence, and keep every order and review in one clear place.</p><div class="hero-actions"><a class="primary-link" href="${pageContext.request.contextPath}/products">Shop the catalog</a><c:choose><c:when test="${not empty sessionScope.userId && sessionScope.userRole == 'BUYER'}"><a class="secondary-link" href="${pageContext.request.contextPath}/orders">View your orders</a></c:when><c:otherwise><a class="secondary-link" href="${pageContext.request.contextPath}/register">Join FakrudeenMart</a></c:otherwise></c:choose></div></div><div class="hero-panel" aria-label="Marketplace highlights"><span class="hero-panel-kicker">Built for clarity</span><strong>Find. Compare. Order.</strong><p>Product details, availability, ratings, cart, checkout, and order history work together in one lightweight experience.</p></div></section><section class="home-value-grid" aria-label="Marketplace benefits"><article><span class="value-number">01</span><h2>Explore with intent</h2><p>Search and filter the live catalog by category, price, stock, and sorting options.</p><a href="${pageContext.request.contextPath}/products">Browse products →</a></article><article><span class="value-number">02</span><h2>Buy with confidence</h2><p>Review server-calculated cart totals, stock availability, and order snapshots before placing an order.</p><a href="${pageContext.request.contextPath}/products">Start shopping →</a></article><article><span class="value-number">03</span><h2>Share experience</h2><p>Verified buyers can leave ratings and reviews after purchasing a product.</p><a href="${pageContext.request.contextPath}/products">See the catalog →</a></article></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
