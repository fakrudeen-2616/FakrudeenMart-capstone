<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Statistics | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/users">Users</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><span class="muted">Statistics</span><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="admin-heading"><p class="eyebrow">Platform statistics</p><h1>Marketplace overview</h1></section><section class="admin-stat-grid"><article class="admin-stat-card"><span>Total users</span><strong>${stats.totalUsers}</strong><small>${stats.activeUsers} active · ${stats.inactiveUsers} inactive</small></article><article class="admin-stat-card"><span>Buyers</span><strong>${stats.buyers}</strong><small>Registered buyer accounts</small></article><article class="admin-stat-card"><span>Sellers</span><strong>${stats.sellers}</strong><small>Registered seller accounts</small></article><article class="admin-stat-card"><span>Total products</span><strong>${stats.totalProducts}</strong><small>${stats.activeProducts} active · ${stats.inactiveProducts} inactive</small></article><article class="admin-stat-card"><span>Total orders</span><strong>${stats.totalOrders}</strong><small>${stats.cancelledOrders} cancelled</small></article><article class="admin-stat-card admin-stat-accent"><span>Total sales</span><strong>₹<fmt:formatNumber value="${stats.totalSales}" minFractionDigits="2" maxFractionDigits="2"/></strong><small>Historical order totals</small></article></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
