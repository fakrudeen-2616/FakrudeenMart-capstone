<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Seller Orders | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="seller-shell"><header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/seller/dashboard">FAKRUDEENMART SELLER CENTER</a><nav><a href="${pageContext.request.contextPath}/seller/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/seller/products">My Products</a><span class="muted">Orders</span><a href="${pageContext.request.contextPath}/seller/profile">Profile</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="seller-heading"><p class="eyebrow">Your sales</p><h1>Relevant orders</h1><p class="catalog-intro">Only items belonging to your seller account are shown.</p></section><c:choose><c:when test="${empty orders}"><section class="empty-state"><h2>No relevant orders yet.</h2><p>Orders containing your products will appear here.</p></section></c:when><c:otherwise><section class="seller-order-list"><c:forEach var="order" items="${orders}"><article class="seller-order-card"><header><div><p class="eyebrow">Order #${order.orderId}</p><h2><c:out value="${order.buyerName}"/></h2><p class="muted">${order.createdAt}</p></div><div class="seller-order-status"><span class="status-pill">${order.status}</span><strong>₹<fmt:formatNumber value="${order.sellerSubtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></div></header><ul><c:forEach var="item" items="${order.items}"><li><span><c:out value="${item.productName}"/> × ${item.quantity}</span><strong>₹<fmt:formatNumber value="${item.subtotal}" minFractionDigits="2" maxFractionDigits="2"/></strong></li></c:forEach></ul><a class="text-link" href="${pageContext.request.contextPath}/seller/order?id=${order.orderId}">View order →</a></article></c:forEach></section></c:otherwise></c:choose></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
