<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Profile | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/users">Users</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><a href="${pageContext.request.contextPath}/admin/statistics">Statistics</a><span class="muted">Profile</span><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="form-heading"><p class="eyebrow">Account</p><h1>Admin profile</h1></section><section class="profile-card"><dl><dt>Name</dt><dd><c:out value="${admin.fullName}"/></dd><dt>Email</dt><dd><c:out value="${admin.email}"/></dd><dt>Phone</dt><dd><c:out value="${admin.phone}"/></dd><dt>Role</dt><dd>${admin.role}</dd><dt>Status</dt><dd>${admin.status}</dd><dt>Registered</dt><dd>${admin.createdAt}</dd></dl><p class="muted small">Administrator role and account authorization are protected and cannot be changed from this page.</p></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
