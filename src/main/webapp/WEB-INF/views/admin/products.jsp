<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Products | FakrudeenMart</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="admin-shell"><header class="admin-header"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">FAKRUDEENMART ADMIN</a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/users">Users</a><a href="${pageContext.request.contextPath}/admin/buyers">Buyers</a><a href="${pageContext.request.contextPath}/admin/sellers">Sellers</a><span class="muted">Products</span><a href="${pageContext.request.contextPath}/admin/orders">Orders</a><a href="${pageContext.request.contextPath}/logout">Logout</a></nav></header><section class="admin-heading"><p class="eyebrow">Platform catalog</p><h1>Products</h1></section><form class="admin-filter-form" method="get"><input name="search" placeholder="Search product, seller, or category" value="<c:out value='${param.search}'/>"><select name="sellerId"><option value="">All sellers</option><c:forEach var="seller" items="${sellers}"><option value="${seller.id}" ${param.sellerId == seller.id.toString() ? 'selected' : ''}><c:out value="${seller.fullName}"/></option></c:forEach></select><select name="categoryId"><option value="">All categories</option><c:forEach var="category" items="${categories}"><option value="${category.id}" ${param.categoryId == category.id.toString() ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select><select name="status"><option value="">All statuses</option><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option></select><select name="stock"><option value="">All stock</option><option value="IN">In stock</option><option value="OUT">Out of stock</option></select><button type="submit">Filter</button></form><section class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>Product</th><th>Seller</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach var="product" items="${products}"><tr><td>${product.id}</td><td><c:out value="<c:out value='${product.name}'/>"/></td><td><c:out value="${product.sellerName}"/></td><td><c:out value="${product.categoryName}"/></td><td>₹<fmt:formatNumber value="${product.price}" minFractionDigits="2" maxFractionDigits="2"/></td><td>${product.stockQuantity}</td><td><span class="status-pill">${product.status}</span></td><td class="admin-row-actions"><a href="${pageContext.request.contextPath}/admin/products/edit?id=${product.id}">Edit</a><form method="post" action="${pageContext.request.contextPath}/admin/products/status" onsubmit="return confirm('Change this product status?');"><input type="hidden" name="id" value="${product.id}"><input type="hidden" name="status" value="${product.status == 'ACTIVE' ? 'INACTIVE' : 'ACTIVE'}"><button class="table-button" type="submit">${product.status == 'ACTIVE' ? 'Deactivate' : 'Activate'}</button></form></td></tr></c:forEach></tbody></table><c:if test="${empty products}"><p class="empty-inline">No matching products.</p></c:if></section></main><script src="${pageContext.request.contextPath}/js/app.js" defer></script></body></html>
